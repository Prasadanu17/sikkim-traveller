# ─────────────────────────────────────────────────────────────────────────────
# Sikkim Traveller Frontend — Environment Variables (.env.example)
#
# CRITICAL SECURITY NOTICE:
# - All VITE_* variables are embedded into client JavaScript bundles at BUILD TIME.
# - NEVER place database passwords, private encryption keys, or secrets here.
# - For separate domain staging:
#   Frontend: https://staging.sikkim-traveller.com
#   Backend:  https://api-staging.sikkim-traveller.com
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API Resolution ───────────────────────────────────────────────────
# Base URL for the Express backend API.
# Staging: https://api-staging.sikkim-traveller.com
# Production: https://api.sikkim-traveller.com
# Local development: leave blank if using Vite proxy, or http://localhost:3001
VITE_API_URL=https://api-staging.sikkim-traveller.com

# ── Backend Integration Toggles ──────────────────────────────────────────────
# Set to 'false' in staging/production to connect to the real Express backend.
# Set to 'true' in offline frontend-only development for in-browser simulation.
VITE_CUSTOMER_API_MOCK_MODE=false
VITE_CUSTOMER_PORTAL_MOCK_MODE=false
VITE_OPERATIONS_MOCK_MODE=false
VITE_PAYMENT_MOCK_MODE=false
VITE_NOTIFICATIONS_MOCK_MODE=false

# ── Optional Specific Endpoint Overrides (auto-derived from VITE_API_URL if unset) ──
# VITE_ITINERARY_API_ENDPOINT=https://api-staging.sikkim-traveller.com/api/generate-itinerary
# VITE_REFINEMENT_API_ENDPOINT=https://api-staging.sikkim-traveller.com/api/refine-itinerary
# VITE_COPILOT_API_ENDPOINT=https://api-staging.sikkim-traveller.com/api/copilot
# VITE_COPILOT_STREAM_ENDPOINT=https://api-staging.sikkim-traveller.com/api/copilot/stream
# VITE_CUSTOMER_API_BASE_URL=https://api-staging.sikkim-traveller.com/api/customer

# ── Client Contact Form Fallback (Optional) ──────────────────────────────────
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
