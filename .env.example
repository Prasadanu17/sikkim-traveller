# ─────────────────────────────────────────────────────────────────────────────
# Sikkim Traveller Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Web3Forms access key for frontend form submission fallback
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# ── Backend Integration Toggle Toggles ───────────────────────────────────────
# Set to 'false' to switch from Mock simulation to the real Production Backend API.
VITE_CUSTOMER_API_MOCK_MODE=true
VITE_CUSTOMER_PORTAL_MOCK_MODE=true
VITE_OPERATIONS_MOCK_MODE=true
VITE_PAYMENT_MOCK_MODE=true
VITE_NOTIFICATIONS_MOCK_MODE=true

# ── API Endpoints (Wired to the production backend when mock modes are false) ──
VITE_CUSTOMER_API_BASE_URL=http://localhost:3001/api/customer
VITE_REALTIME_API_ENDPOINT=http://localhost:3001/api/realtime
VITE_ITINERARY_API_ENDPOINT=http://localhost:3001/api/generate-itinerary
VITE_COPILOT_API_ENDPOINT=http://localhost:3001/api/copilot

# ── Mock Operational Roles (Used when VITE_OPERATIONS_MOCK_MODE is true) ──────
VITE_OPS_MOCK_USER="Dev Operator"
VITE_OPS_MOCK_ROLE=OPERATIONS_MANAGER
