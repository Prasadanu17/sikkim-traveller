# ─────────────────────────────────────────────────────────────────────────────
# Sikkim Traveller Backend — Environment Variables (.env.example)
#
# CRITICAL SECURITY RULES:
# - NEVER commit .env files to Git or deploy them to client code.
# - Generate unique secrets for each environment (dev, staging, production).
# - Staging separate domain setup:
#   Frontend domain: https://staging.sikkim-traveller.com
#   Backend domain:  https://api-staging.sikkim-traveller.com
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime Environment ──────────────────────────────────────────────────────
# Options: development | test | staging | production
NODE_ENV=staging
PORT=3001

# ── Cross-Origin Resource Sharing (CORS) ─────────────────────────────────────
# Comma-separated list of allowed frontend origins (NO trailing slashes).
# Staging: https://staging.sikkim-traveller.com
# Development: http://localhost:5173
CORS_ORIGIN=https://staging.sikkim-traveller.com

# ── Supabase PostgreSQL Database (Prisma 5.20+) ──────────────────────────────
# 1. DATABASE_URL: Connects via Supabase Connection Pooler (Supavisor / port 6543).
#    Used for application runtime queries. Includes ?pgbouncer=true&sslmode=require.
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# 2. DIRECT_URL: Direct PostgreSQL connection (port 5432 or direct pooler).
#    Used by Prisma CLI for running migrations ('npx prisma migrate deploy').
DIRECT_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# ── Supabase Storage (Optional Document & Voucher Storage) ───────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=sikkim-traveller-documents

# ── Secret Salt & Session Tokens ─────────────────────────────────────────────
# MUST be generated securely with Node.js crypto (minimum 32 bytes / 64 hex chars).
# Run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_TOKEN_PEPPER=your-64-character-hex-customer-token-pepper-salt-here
OPS_SESSION_SECRET=your-64-character-hex-operations-session-secret-here

# Token Lifetimes
JOURNEY_TOKEN_EXPIRY_DAYS=365
SESSION_EXPIRY_HOURS=24

# ── Razorpay Payment Gateway (Test Mode) ─────────────────────────────────────
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Weather Proxy (Open-Meteo — Free Public API, no key required) ────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_MINUTES=30

# ── AI Trip Engine (Google Gemini) — POSTPONED / OPTIONAL ────────────────────
# Gemini integration is postponed until Supabase PostgreSQL persistence is verified.
# The backend operates deterministically when GEMINI_API_KEY is unset or unconfigured.
# Leave blank or commented out for initial staging:
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# ── Server Rate Limiting & Logging ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
