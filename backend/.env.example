# ─────────────────────────────────────────────────────────────────
# Sikkim Traveller Backend — Environment Variables
# Copy to .env and fill in values before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development

# ── Supabase (PostgreSQL + Storage) ─────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=sikkim-traveller-documents

# ── Token Security ───────────────────────────────────────────────
# Used only for HMAC verification of webhook signatures and session signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CUSTOMER_TOKEN_HMAC_SECRET=your-64-byte-hex-secret-here
SESSION_SECRET=your-separate-64-byte-hex-session-secret

# Token TTL configuration
JOURNEY_TOKEN_EXPIRY_DAYS=365
SESSION_EXPIRY_HOURS=24

# ── Razorpay (Payments) ──────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sikkimtraveller.com

# ── Operations Staff (JWT or session) ───────────────────────────
# For production: replace with real staff SSO or internal JWT secret
OPS_JWT_SECRET=your-operations-jwt-secret-here
OPS_JWT_EXPIRY=8h

# ── Weather Proxy (Open-Meteo — no API key needed) ───────────────
# Optional: if switching to a paid provider
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_TTL_MINUTES=30

# ── Notification Providers (optional — configure when ready) ─────
# Email (SendGrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# WhatsApp (Twilio / Meta WABA)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS
SMS_PROVIDER=twilio

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
# Set to 'true' in production to disable verbose request logging
LOG_OMIT_REQUEST_BODY=false
